# ============================================================
# Gestão Fretamento Pro — Environment Variables
#
# Como usar:
#   cp .env.example .env
#   Preencha os valores obrigatórios marcados com [OBRIGATÓRIO]
#
# NUNCA comite o arquivo .env no git!
# O .gitignore já está configurado para ignorá-lo.
#
# Gerar secrets seguros:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# ============================================================

# ──────────────────────────────────────────────
# Banco de Dados — [OBRIGATÓRIO]
# ──────────────────────────────────────────────

# URL de conexão via PgBouncer (usada pela aplicação em runtime)
# Formato: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://gfp:gfp_dev_password@localhost:5432/gestao_fretamento_pro"

# URL direta ao PostgreSQL (usada pelo Prisma para migrations — bypassa PgBouncer)
# Em desenvolvimento pode ser igual ao DATABASE_URL
# Em produção deve apontar para o host RDS diretamente, não via pooler
DIRECT_URL="postgresql://gfp:gfp_dev_password@localhost:5432/gestao_fretamento_pro"

# ──────────────────────────────────────────────
# Cache e Filas — [OBRIGATÓRIO]
# ──────────────────────────────────────────────

# URL de conexão do Redis
# Formato: redis://[:password@]host:port[/db-number]
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# Autenticação JWT — [OBRIGATÓRIO]
# Mínimo 32 caracteres — gere com: openssl rand -hex 32
# ──────────────────────────────────────────────

# Secret usado para assinar access tokens (expiração: 15 minutos)
JWT_SECRET="change-me-to-a-secure-random-string-minimum-32-chars"

# Secret usado para assinar refresh tokens (expiração: 7 dias)
JWT_REFRESH_SECRET="change-me-to-another-secure-random-string-min-32"

# ──────────────────────────────────────────────
# Servidor — [OBRIGATÓRIO]
# ──────────────────────────────────────────────

# Porta em que a API escuta
PORT=3000

# Ambiente de execução: development | staging | production
NODE_ENV=development

# URL pública da API (usada para gerar links em e-mails, webhooks, etc.)
APP_URL="http://localhost:3000"

# Origins permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# URL do frontend (usada para redirects de autenticação)
FRONTEND_URL="http://localhost:3001"

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────

# Janela de tempo para rate limiting em milissegundos (padrão: 60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# ──────────────────────────────────────────────
# OpenTelemetry (Observabilidade)
# Deixe comentado em desenvolvimento se não usar um collector local
# ──────────────────────────────────────────────

# Nome do serviço reportado ao trace collector
OTEL_SERVICE_NAME=api-core

# Endpoint do OTLP collector (Jaeger, Grafana Tempo, Datadog, etc.)
# Exemplo para Jaeger local: http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ──────────────────────────────────────────────
# Object Storage S3 / MinIO
# Deixe comentado se não usar uploads de documentos em desenvolvimento
# ──────────────────────────────────────────────

# Nome do bucket S3 para armazenamento de documentos
# S3_BUCKET=gfp-documents

# Região da AWS (padrão: us-east-1)
S3_REGION=us-east-1

# Credenciais AWS (ou MinIO em desenvolvimento)
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Endpoint personalizado para S3-compatível (MinIO em dev, deixe vazio para AWS S3 real)
# S3_ENDPOINT=http://localhost:9000
