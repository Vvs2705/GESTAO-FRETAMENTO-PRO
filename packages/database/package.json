{
  "name": "@gestao-fretamento-pro/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate --schema=schema/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=schema/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=schema/schema.prisma",
    "db:validate": "prisma validate --schema=schema/schema.prisma",
    "db:studio": "prisma studio --schema=schema/schema.prisma",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "@gestao-fretamento-pro/tsconfig": "workspace:*",
    "prisma": "^5.15.0",
    "typescript": "^5.4.0"
  }
}
