{
  "consumer": {
    "name": "web-admin"
  },
  "provider": {
    "name": "api-core"
  },
  "interactions": [
    {
      "description": "a request for login",
      "providerState": "user exists",
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "admin@fretamento.com",
          "role": "admin"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "accessToken": "mock-token",
          "refreshToken": "mock-refresh",
          "user": {
            "id": "usr_123",
            "name": "admin",
            "email": "admin@fretamento.com",
            "role": "admin",
            "tenantId": "ten_1"
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
