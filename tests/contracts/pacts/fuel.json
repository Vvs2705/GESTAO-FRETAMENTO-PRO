        "body": {
          "vehicleId": "vehicle_1",
          "odometer": 12500.5,
          "liters": 45.2,
          "totalAmount": 250.00
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "id": "fuel_123",
          "vehicleId": "vehicle_1",
          "anomalyFlag": false
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
